static string SuppliersDbPath(string contentRoot) => Path.Combine(contentRoot, "suppliers.db");
static void EnsureSuppliersDb(string contentRoot)
{
    var path = SuppliersDbPath(contentRoot);
    Directory.CreateDirectory(Path.GetDirectoryName(path)!);

    using var con = new SqliteConnection($"Data Source={path}");
    con.Open();

    var cmd = con.CreateCommand();
    cmd.CommandText = @"
CREATE TABLE IF NOT EXISTS suppliers(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  phone TEXT,
  vatNumber TEXT,
  crNumber TEXT,
  address TEXT,
  notes TEXT
);
CREATE TABLE IF NOT EXISTS supplier_invoices(
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  supplierId INTEGER NOT NULL,
  invoiceNo TEXT,
  invoiceDate TEXT,
  total REAL NOT NULL,
  vat REAL NOT NULL,
  notes TEXT,
  createdAt TEXT NOT NULL,
  FOREIGN KEY(supplierId) REFERENCES suppliers(id)
);
";
    cmd.ExecuteNonQuery();
}
