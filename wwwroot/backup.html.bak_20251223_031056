<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>النسخ الاحتياطي والاستعادة</title>
  <style>
    :root{
      --bg:#f6f7fb;
      --card:#ffffff;
      --text:#0f172a;
      --muted:#64748b;
      --line:#e5e7eb;
      --brand:#2563eb;
      --brand2:#111827;
      --danger:#b91c1c;
      --ok:#16a34a;
      --shadow:0 12px 28px rgba(2,6,23,.08);
      --radius:16px;
    }
    *{box-sizing:border-box}
    body{margin:0; font-family:system-ui,Segoe UI,Tahoma,Arial; background:var(--bg); color:var(--text)}
    .wrap{max-width:1050px; margin:24px auto; padding:0 16px}
    .card{background:var(--card); border:1px solid var(--line); border-radius:var(--radius); box-shadow:var(--shadow); overflow:hidden}
    header{padding:18px 18px 10px 18px; border-bottom:1px solid var(--line)}
    h1{margin:0; font-size:20px}
    .sub{margin-top:6px; color:var(--muted); font-size:13px; line-height:1.6}
    .bar{display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:space-between; padding:14px 18px; border-bottom:1px solid var(--line); background:#fbfbfe}
    .left,.right{display:flex; gap:10px; flex-wrap:wrap; align-items:center}
    button{
      cursor:pointer; border:1px solid transparent; border-radius:12px;
      padding:10px 14px; font-weight:800; font-size:14px;
      transition:.15s transform,.15s opacity,.15s background,.15s border-color;
    }
    button:active{transform:translateY(1px)}
    .btn{background:var(--brand); color:#fff}
    .btn2{background:var(--brand2); color:#fff}
    .ghost{background:#fff; border-color:var(--line); color:var(--text)}
    .danger{background:var(--danger); color:#fff}
    .hint{color:var(--muted); font-size:13px}
    .status{padding:10px 18px; color:var(--muted); font-size:13px}
    table{width:100%; border-collapse:collapse}
    th,td{padding:12px 14px; border-bottom:1px solid var(--line); text-align:right; font-size:14px}
    th{font-size:12px; color:var(--muted); background:#fff}
    .actions{display:flex; gap:8px; flex-wrap:wrap}
    a{color:var(--brand); text-decoration:none; font-weight:800}
    code{background:#f1f5f9; padding:2px 6px; border-radius:8px; font-family:ui-monospace,Consolas,monospace; font-size:12px}
    .pill{display:inline-flex; gap:8px; align-items:center; padding:8px 10px; border:1px dashed var(--line); border-radius:999px; background:#fff}
    .warnbox{
      margin:12px 18px 18px 18px; padding:12px 14px;
      border:1px solid #fecaca; background:#fff1f2; color:#7f1d1d; border-radius:14px;
      font-size:13px; line-height:1.7;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <header>
        <h1>النسخ الاحتياطي والاستعادة</h1>
        <div class="sub">
          نقاط الـ API: <code>/api/backup/list</code> • <code>/api/backup/run</code> •
          <code>/api/backup/download/{name}</code> • <code>/api/backup/restore/{name}</code>
        </div>
      </header>

      <div class="bar">
        <div class="left">
          <button class="ghost" onclick="goHome()">⬅️ العودة للرئيسية</button>
          <div class="pill">
            <span class="hint">المجلد:</span>
            <code>backups/</code>
          </div>
        </div>
        <div class="right">
          <button class="ghost" onclick="refreshList()">تحديث</button>
          <button class="btn" onclick="runNow()">إنشاء نسخة الآن</button>
        </div>
      </div>

      <div id="status" class="status">جاهز ✅</div>

      <div class="warnbox">
        <b>تنبيه:</b> الاستعادة هنا <b>كاملة</b> (تحذف جداول قاعدة البيانات الحالية ثم تعيد بناءها من ملف النسخة).
        استخدمها فقط عندما تكون متأكد 100% — هذا الزر ما يعرف المزح 😅
      </div>

      <table>
        <thead>
          <tr>
            <th style="width:40%">الملف</th>
            <th style="width:14%">الحجم</th>
            <th style="width:22%">آخر تعديل</th>
            <th style="width:24%">إجراءات</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </div>

<script>
async function api(path, options){
  const res = await fetch(path, Object.assign({
    headers: { "Content-Type":"application/json" }
  }, options || {}));
  if(!res.ok){
    const t = await res.text().catch(() => "");
    throw new Error("HTTP " + res.status + " " + (t || res.statusText));
  }
  return res;
}

function fmtBytes(n){
  n = Number(n||0);
  if(n < 1024) return n + " B";
  const u = ["KB","MB","GB","TB"];
  let i=-1, v=n;
  while(v >= 1024 && i < u.length-1){ v/=1024; i++; }
  return v.toFixed(i<=0?1:2) + " " + u[i];
}

function setStatus(msg, ok){
  const el = document.getElementById("status");
  el.textContent = msg;
  el.style.color = ok===true ? "#166534" : (ok===false ? "#7f1d1d" : "#64748b");
}

function goHome(){
  // adjust if you have a specific home page
  location.href = "/";
}

async function refreshList(){
  setStatus("⏳ جاري جلب النسخ...", null);
  try{
    const j = await (await api("/api/backup/list")).json();
    const tbody = document.getElementById("rows");
    tbody.innerHTML = "";
    (j.files || []).forEach(function(f){
      const tr = document.createElement("tr");
      const name = f.name || "";
      tr.innerHTML =
        "<td><b>" + name + "</b></td>" +
        "<td>" + fmtBytes(f.size || 0) + "</td>" +
        "<td>" + (f.modifiedLocal || "") + "</td>" +
        "<td>" +
          "<div class='actions'>" +
            "<a href='/api/backup/download/" + encodeURIComponent(name) + "' target='_blank'>تحميل</a>" +
            "<button class='danger' style='padding:8px 10px' onclick='restoreOne(" + JSON.stringify(name) + ")'>استعادة</button>" +
          "</div>" +
        "</td>";
      tbody.appendChild(tr);
    });
    setStatus("✅ تم. عدد النسخ: " + ((j.files||[]).length), true);
  }catch(e){
    setStatus("❌ " + e.message, false);
  }
}

async function runNow(){
  setStatus("⏳ جاري إنشاء النسخة...", null);
  try{
    const j = await (await api("/api/backup/run", { method:"POST" })).json();
    setStatus("✅ تم إنشاء: " + (j.file || "(بدون اسم)"), true);
    await refreshList();
  }catch(e){
    setStatus("❌ " + e.message, false);
  }
}

async function restoreOne(name){
  const yes = confirm("استعادة كاملة من النسخة: " + name + "\n\nسيتم حذف الجداول الحالية وإعادة الاستعادة.\nمتأكد؟");
  if(!yes) return;

  setStatus("⏳ جاري الاستعادة... لا تغلق الصفحة", null);
  try{
    await api("/api/backup/restore/" + encodeURIComponent(name), { method:"POST" });
    setStatus("✅ تمت الاستعادة من: " + name, true);
    alert("تمت الاستعادة بنجاح.\nقد تحتاج تحديث الصفحة.");
  }catch(e){
    setStatus("❌ " + e.message, false);
  }
}

refreshList();
</script>
</body>
</html>
