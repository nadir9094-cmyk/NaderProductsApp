}

function fmtBytes(n){
  n = Number(n||0);
  if(n < 1024) return n + " B";
  const u = ["KB","MB","GB","TB"];
  let i=-1, v=n;
  while(v >= 1024 && i < u.length-1){ v/=1024; i++; }
  return v.toFixed(i<=0?1:2) + " " + u[i];
}

