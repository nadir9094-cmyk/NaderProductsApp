// AdminKey: ضع قيمة في appsettings.json مثلاً:
// { "AdminKey": "CHANGE_ME_123" }
// وسترسل من لوحة الإدارة في الهيدر: X-ADMIN-KEY

static string GetAdminKey(IConfiguration cfg)
    => (cfg["AdminKey"] ?? cfg["Licensing:AdminKey"] ?? "").Trim();

static bool CheckAdmin(HttpRequest req, IConfiguration cfg, out IResult? fail)
{
    fail = null;
    var key = GetAdminKey(cfg);
    if (string.IsNullOrWhiteSpace(key))
    {
        fail = Results.Problem("AdminKey is not configured in appsettings.json", statusCode: 500);
        return false;
    }
    var got = (req.Headers["X-ADMIN-KEY"].ToString() ?? "").Trim();
    if (string.IsNullOrWhiteSpace(got) || !string.Equals(got, key, StringComparison.Ordinal))
    {
        fail = Results.Unauthorized();
        return false;
    }
    return true;
}

static async Task<Npgsql.NpgsqlConnection> OpenPg(IConfiguration cfg)
{
    var cs = cfg.GetConnectionString("Default");
    if (string.IsNullOrWhiteSpace(cs)) throw new Exception("Missing connection string: Default");
    var con = new Npgsql.NpgsqlConnection(cs);
    await con.OpenAsync();
    return con;
}

static async Task EnsureLicensingTables(IConfiguration cfg)
{
    await using var con = await OpenPg(cfg);
    var sql = @"
CREATE TABLE IF NOT EXISTS lic_plans (
  id BIGSERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  days INT NOT NULL,
  price NUMERIC(12,2) NOT NULL DEFAULT 0,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  updated_utc TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS lic_keys (
  id BIGSERIAL PRIMARY KEY,
  serial TEXT NOT NULL UNIQUE,
  plan_id BIGINT NOT NULL REFERENCES lic_plans(id) ON DELETE RESTRICT,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  max_devices INT NOT NULL DEFAULT 1,
  created_utc TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
";
    await using var cmd = new Npgsql.NpgsqlCommand(sql, con);
    await cmd.ExecuteNonQueryAsync();

    // seed default plans if empty
    var countSql = "SELECT COUNT(*) FROM lic_plans;";
    await using var ccmd = new Npgsql.NpgsqlCommand(countSql, con);
    var count = (long)(await ccmd.ExecuteScalarAsync() ?? 0L);
    if (count == 0)
    {
        var seed = @"
INSERT INTO lic_plans(name,days,price,is_active) VALUES
 (N'شهر', 30, 49, TRUE),
 (N'3 أشهر', 90, 129, TRUE),
 (N'سنة', 365, 399, TRUE);
";
        await using var scmd = new Npgsql.NpgsqlCommand(seed, con);
        await scmd.ExecuteNonQueryAsync();
    }
}

