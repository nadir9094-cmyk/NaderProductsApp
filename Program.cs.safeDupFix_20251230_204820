app.MapPost("/api/admin/plans", async (HttpRequest req, IConfiguration cfg) =>
{
    if (!CheckAdmin(req, cfg, out var fail)) return fail!;
    var body = await req.ReadFromJsonAsync<JsonElement>();
    if (body.ValueKind != JsonValueKind.Object) return Results.BadRequest("INVALID_BODY");

    var name = body.TryGetProperty("name", out var n) ? (n.GetString() ?? "").Trim() : "";
    var days = body.TryGetProperty("days", out var d) && d.ValueKind == JsonValueKind.Number ? d.GetInt32() : 0;

    decimal price = 0m;
    if (body.TryGetProperty("price", out var p))
    {
        if (p.ValueKind == JsonValueKind.Number) price = p.GetDecimal();
        else if (p.ValueKind == JsonValueKind.String) decimal.TryParse(p.GetString(), out price);
    }

    var isActive = body.TryGetProperty("isActive", out var a)
        ? (a.ValueKind == JsonValueKind.True || (a.ValueKind == JsonValueKind.Number && a.GetInt32() != 0))
        : true;

    // Offer fields (optional)
    string? offerType = null;
    decimal? offerValue = null;
    DateTime? offerStart = null;
    DateTime? offerEnd = null;

    if (body.TryGetProperty("offerType", out var ot) && ot.ValueKind == JsonValueKind.String)
        offerType = (ot.GetString() ?? "").Trim().ToUpperInvariant();

    if (body.TryGetProperty("offerValue", out var ov))
    {
        if (ov.ValueKind == JsonValueKind.Number) offerValue = ov.GetDecimal();
        else if (ov.ValueKind == JsonValueKind.String && decimal.TryParse(ov.GetString(), out var vv)) offerValue = vv;
    }

    if (body.TryGetProperty("offerStart", out var os) && os.ValueKind == JsonValueKind.String && DateTime.TryParse(os.GetString(), out var ds)) offerStart = ds.ToUniversalTime();
    if (body.TryGetProperty("offerEnd", out var oe) && oe.ValueKind == JsonValueKind.String && DateTime.TryParse(oe.GetString(), out var de)) offerEnd = de.ToUniversalTime();

    // Validation
    if (string.IsNullOrWhiteSpace(name)) return Results.BadRequest("NAME_REQUIRED");
    if (days <= 0) return Results.BadRequest("DAYS_REQUIRED");
    if (price < 0m) return Results.BadRequest("PRICE_INVALID");

    if (!string.IsNullOrWhiteSpace(offerType) || (offerValue.HasValue && offerValue.Value > 0m))
    {
        if (offerType != "PERCENT" && offerType != "AMOUNT") return Results.BadRequest("OFFER_TYPE_INVALID");
        if (!offerValue.HasValue || offerValue.Value <= 0m) return Results.BadRequest("OFFER_VALUE_REQUIRED");
        if (offerType == "PERCENT" && offerValue.Value > 100m) return Results.BadRequest("OFFER_PERCENT_MAX_100");
        if (offerStart.HasValue && offerEnd.HasValue && offerEnd.Value < offerStart.Value) return Results.BadRequest("OFFER_DATE_RANGE_INVALID");
    }

    await using var con = await OpenPg(cfg);
    var sql = @"INSERT INTO lic_plans(name,days,price,is_active,offer_type,offer_value,offer_start,offer_end,updated_utc)
                VALUES (@name,@days,@price,@act,@ot,@ov,@os,@oe,NOW()) RETURNING id;";
    await using var cmd = new Npgsql.NpgsqlCommand(sql, con);
    cmd.Parameters.AddWithValue("name", name);
    cmd.Parameters.AddWithValue("days", days);
    cmd.Parameters.AddWithValue("price", price);
    cmd.Parameters.AddWithValue("act", isActive);
    cmd.Parameters.AddWithValue("ot", (object?)offerType ?? DBNull.Value);
    cmd.Parameters.AddWithValue("ov", (object?)offerValue ?? DBNull.Value);
    cmd.Parameters.AddWithValue("os", (object?)offerStart ?? DBNull.Value);
    cmd.Parameters.AddWithValue("oe", (object?)offerEnd ?? DBNull.Value);

    var id = (long)(await cmd.ExecuteScalarAsync() ?? 0L);
    return Results.Ok(new { ok = true, id });
});
