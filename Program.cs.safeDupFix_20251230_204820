 app.MapGet("/api/admin/subscribers", async (HttpRequest req, IConfiguration cfg) =>
 {
     if (!CheckAdmin(req, cfg, out var fail)) return fail!;

     int take = 500;
     if (int.TryParse(req.Query["take"], out var t)) take = Math.Clamp(t, 1, 5000);

     await using var con = await OpenPg(cfg);
     await using var cmd = new Npgsql.NpgsqlCommand(@"
       SELECT
         s.device_id,
         COALESCE(s.store_name,'') AS store_name,
         COALESCE(s.store_address,'') AS store_address,
         COALESCE(s.mode,'NONE') AS mode,
         COALESCE(s.serial,'') AS serial,
         s.expires_utc,
         s.last_check_utc,
         COALESCE(s.is_blocked,false) AS is_blocked,
         COALESCE(s.block_reason,'') AS block_reason
       FROM lic_device_subs s
       ORDER BY s.last_check_utc DESC
       LIMIT @take;
     ", con);
     cmd.Parameters.AddWithValue("take", take);

     var list = new List<object>();
     await using var rd = await cmd.ExecuteReaderAsync();
     while (await rd.ReadAsync())
     {
         var expires = rd.GetDateTime(5);
         var isBlocked = rd.GetBoolean(7);
         var isActive = (!isBlocked) && expires > DateTime.UtcNow;

         var leftDays = (int)Math.Ceiling((expires - DateTime.UtcNow).TotalDays);

         list.Add(new {
             deviceId = rd.GetString(0),
             storeName = rd.GetString(1),
             storeAddress = rd.GetString(2),
             mode = rd.GetString(3),
             serial = rd.GetString(4),
             expiresUtc = expires,
             lastCheckUtc = rd.GetDateTime(6),
             isBlocked,
             blockReason = rd.GetString(8),
             isActive,
             leftDays
         });
     }
     return Results.Ok(new { ok=true, subscribers=list });
 });

