#region REPORTS_API_V1
app.MapGet("/api/reports/summary", async (AppDbContext db, HttpRequest req) =>
{
    string? from = req.Query["from"].ToString();
    string? to   = req.Query["to"].ToString();
    string? expiryNearDaysStr = req.Query["expiryNearDays"].ToString();

    DateTime ParseDayUtc(string? s, DateTime fallbackUtc)
    {
        if (string.IsNullOrWhiteSpace(s)) return DateTime.SpecifyKind(fallbackUtc.Date, DateTimeKind.Utc);

        if (DateTime.TryParseExact(s.Trim(), "yyyy-MM-dd", null,
            System.Globalization.DateTimeStyles.None, out var d))
            return DateTime.SpecifyKind(d.Date, DateTimeKind.Utc);

        if (DateTime.TryParse(s, out var d2))
            return DateTime.SpecifyKind(d2.Date, DateTimeKind.Utc);

        return DateTime.SpecifyKind(fallbackUtc.Date, DateTimeKind.Utc);
    }

    var nowUtc   = DateTime.UtcNow;
    var fromUtc  = ParseDayUtc(from, nowUtc);
    var toUtcDay = ParseDayUtc(to, nowUtc);
    var toUtcEnd = DateTime.SpecifyKind(toUtcDay.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc);

    int nearDays = 30;
    if (!string.IsNullOrWhiteSpace(expiryNearDaysStr) && int.TryParse(expiryNearDaysStr, out var nd)) nearDays = nd;
    if (nearDays < 0) nearDays = 0;
    if (nearDays > 3650) nearDays = 3650;

    var nearUtcEnd = DateTime.SpecifyKind(nowUtc.Date.AddDays(nearDays + 1).AddTicks(-1), DateTimeKind.Utc);

    // ====== Sales / Invoices ======
    var qInv = db.CashierInvoices.AsNoTracking()
        .Where(x => x.InvoiceDate >= fromUtc && x.InvoiceDate <= toUtcEnd);

    var invoiceCount   = await qInv.CountAsync();
    var suspendedCount = await qInv.CountAsync(x => x.IsSuspended);

    var salesTotal   = await qInv.SumAsync(x => (decimal?)(x.GrandTotal)) ?? 0m;
    var vatTotal     = await qInv.SumAsync(x => (decimal?)(x.VatTotal)) ?? 0m;
    var returnTotal  = await qInv.SumAsync(x => (decimal?)(x.ReturnAmount)) ?? 0m;

    var cashTotal = await qInv.Where(x => x.PaymentMethod == "cash")
        .SumAsync(x => (decimal?)(x.GrandTotal)) ?? 0m;

    var cardTotal = await qInv.Where(x => x.PaymentMethod == "card")
        .SumAsync(x => (decimal?)(x.GrandTotal)) ?? 0m;

    var deferredTotal = await qInv.Where(x => x.PaymentMethod == "deferred")
        .SumAsync(x => (decimal?)(x.GrandTotal)) ?? 0m;

    // ====== Expenses ======
    var qExp = db.Expenses.AsNoTracking()
        .Where(x => x.Date >= fromUtc && x.Date <= toUtcEnd);

    var expensesTotal = await qExp.SumAsync(x => (decimal?)(x.Amount)) ?? 0m;
    var expensesCount = await qExp.CountAsync();

    // ====== Inventory ======
    var productsCount = await db.Products.AsNoTracking().CountAsync();
    var lowStockCount = await db.Products.AsNoTracking().CountAsync(p => p.Quantity <= p.MinQuantity);

    var expiryNearCount = await db.Products.AsNoTracking()
        .CountAsync(p => p.ExpiryDate != null
            && p.ExpiryDate >= DateTime.SpecifyKind(nowUtc.Date, DateTimeKind.Utc)
            && p.ExpiryDate <= nearUtcEnd);

    

    // ====== Suppliers (from suppliers-store JSON) ======
    decimal suppliersRangePurchases = 0m;
    decimal suppliersRangePayments  = 0m;
    decimal suppliersRangeNet       = 0m;
    decimal suppliersOutstandingAllTime = 0m;

    try
    {
        static DateTime? ParseAnyDate(string? s)
        {
            if (string.IsNullOrWhiteSpace(s)) return null;
            s = s.Trim();
            if (DateTime.TryParseExact(s, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var d1))
                return d1.Date; // date-only
            if (DateTime.TryParse(s, out var d2))
                return d2.Date;
            return null;
        }

        static long ToLong(JsonElement el)
        {
            try
            {
                if (el.ValueKind == JsonValueKind.Number) return el.GetInt64();
                if (el.ValueKind == JsonValueKind.String && long.TryParse(el.GetString(), out var x)) return x;
            }
            catch { }
            return 0L;
        }

        static DateTime? FromCreatedAtMs(long ms)
        {
            if (ms <= 0) return null;
            try { return DateTimeOffset.FromUnixTimeMilliseconds(ms).UtcDateTime.Date; }
            catch { return null; }
        }

        static decimal ToDec(JsonElement el)
        {
            try
            {
                if (el.ValueKind == JsonValueKind.Number) return el.GetDecimal();
                if (el.ValueKind == JsonValueKind.String && decimal.TryParse(el.GetString(), out var d)) return d;
            }
            catch { }
            return 0m;
        }

        static bool ToBool(JsonElement el)
        {
            try
            {
                if (el.ValueKind == JsonValueKind.True) return true;
                if (el.ValueKind == JsonValueKind.False) return false;
                if (el.ValueKind == JsonValueKind.String && bool.TryParse(el.GetString(), out var b)) return b;
                if (el.ValueKind == JsonValueKind.Number) return el.GetInt32() != 0;
            }
            catch { }
            return false;
        }

        var storeRow = await EnsureSuppliersStoreRow(db);
        var rawJson = storeRow.Json ?? DefaultSuppliersJson;

        using var doc = JsonDocument.Parse(rawJson);
        var root = doc.RootElement;

        // invoices
        List<(DateTime? date, decimal total)> invTotals = new();
        if (root.TryGetProperty("invoices", out var invArr) && invArr.ValueKind == JsonValueKind.Array)
        {
            foreach (var inv in invArr.EnumerateArray())
            {
                DateTime? d = null;
                if (inv.TryGetProperty("date", out var jd)) d = ParseAnyDate(jd.GetString());

                decimal amount = inv.TryGetProperty("amount", out var ja) ? ToDec(ja) : 0m;
                decimal vat    = inv.TryGetProperty("vat", out var jv) ? ToDec(jv) : 0m;
                bool isVatIncluded = inv.TryGetProperty("isVatIncluded", out var jinc) ? ToBool(jinc) : false;

                // total with VAT (same logic as suppliers.html: if VAT included -> total=amount, else amount+vat)
                var total = isVatIncluded ? amount : (amount + vat);
                long createdAt = inv.TryGetProperty("createdAt", out var jc) ? ToLong(jc) : 0L;
                var dEff = d ?? FromCreatedAtMs(createdAt);
                invTotals.Add((dEff, total));
}
        }

        // payments
        List<(DateTime? date, decimal amount)> payTotals = new();
        if (root.TryGetProperty("payments", out var payArr) && payArr.ValueKind == JsonValueKind.Array)
        {
            foreach (var p in payArr.EnumerateArray())
            {
                DateTime? d = null;
                if (p.TryGetProperty("date", out var jd)) d = ParseAnyDate(jd.GetString());
                decimal amt = p.TryGetProperty("amount", out var ja) ? ToDec(ja) : 0m;
                long createdAt = p.TryGetProperty("createdAt", out var jc) ? ToLong(jc) : 0L;
                var dEff = d ?? FromCreatedAtMs(createdAt);
                payTotals.Add((dEff, amt));
}
        }

        // range sums
        suppliersRangePurchases = invTotals
            .Where(x => x.date.HasValue && x.date.Value.Date >= fromUtc.Date && x.date.Value.Date <= toUtcEnd.Date)
            .Sum(x => x.total);

        suppliersRangePayments = payTotals
            .Where(x => x.date.HasValue && x.date.Value.Date >= fromUtc.Date && x.date.Value.Date <= toUtcEnd.Date)
            .Sum(x => x.amount);

        suppliersRangeNet = suppliersRangePurchases - suppliersRangePayments;

        // outstanding all time
        var allPurch = invTotals.Sum(x => x.total);
        var allPaid  = payTotals.Sum(x => x.amount);
        suppliersOutstandingAllTime = Math.Max(0m, allPurch - allPaid);
    }
    catch
    {
        // Keep defaults = 0 if suppliers-store is missing or invalid
    }



// ====== Customers / Deferred (from CustomerInvoices + CustomerPayments) ======
decimal customersRangeDebits = 0m;   // إجمالي الذمم (فواتير/سندات على العملاء) داخل الفترة
decimal customersRangePayments = 0m; // إجمالي السداد داخل الفترة
decimal customersRangeNet = 0m;      // صافي (Debits - Payments) داخل الفترة
decimal customersOutstandingAllTime = 0m; // الرصيد المتبقي لكل الوقت

try
{
    // NOTE: التاريخ محفوظ كنص ISO مثل: yyyy-MM-ddTHH:mm:ss  -> المقارنة النصية تعمل
    var fromIso = fromUtc.ToString("yyyy-MM-ddTHH:mm:ss");
    var toIso   = toUtcEnd.ToString("yyyy-MM-ddTHH:mm:ss");

    var qCustInv = db.CustomerInvoices.AsNoTracking()
        .Where(x => x.Date != null && x.Date.CompareTo(fromIso) >= 0 && x.Date.CompareTo(toIso) <= 0);

    var qCustPay = db.CustomerPayments.AsNoTracking()
        .Where(x => x.Date != null && x.Date.CompareTo(fromIso) >= 0 && x.Date.CompareTo(toIso) <= 0);

    var debD = await qCustInv.SumAsync(x => (double?)x.Amount) ?? 0d;
    var payD = await qCustPay.SumAsync(x => (double?)x.Amount) ?? 0d;

    customersRangeDebits = (decimal)debD;
    customersRangePayments = (decimal)payD;
    customersRangeNet = customersRangeDebits - customersRangePayments;

    var allDebD = await db.CustomerInvoices.AsNoTracking().SumAsync(x => (double?)x.Amount) ?? 0d;
    var allPayD = await db.CustomerPayments.AsNoTracking().SumAsync(x => (double?)x.Amount) ?? 0d;
    customersOutstandingAllTime = (decimal)Math.Max(0d, allDebD - allPayD);
}
catch
{
    // Keep defaults = 0 if something is wrong
}

return Results.Ok(new
    {
        from = KsaTime.ToKsaIso(fromUtc),
        to = KsaTime.ToKsaIso(toUtcEnd),
        invoiceCount,
        suspendedCount,
        salesTotal,
        vatTotal,
        returnTotal,
        cashTotal,
        cardTotal,
        deferredTotal,
        expensesTotal,
        expensesCount,
        productsCount,
        lowStockCount,
        expiryNearCount,
        suppliersRangePurchases = suppliersRangePurchases,
        suppliersRangePayments = suppliersRangePayments,
        suppliersRangeNet = suppliersRangeNet,
        suppliersOutstandingAllTime = suppliersOutstandingAllTime,
        customersRangeDebits = customersRangeDebits,
        customersRangePayments = customersRangePayments,
        customersRangeNet = customersRangeNet,
        customersOutstandingAllTime = customersOutstandingAllTime,
        expiryNearDays = nearDays
    });
});
