 app.MapPost("/api/subscription/activate", async (HttpRequest req, IConfiguration cfg) =>
 {
     var body = await req.ReadFromJsonAsync<JsonElement>();
     if (body.ValueKind != JsonValueKind.Object) return Results.BadRequest("INVALID_BODY");

     var deviceId = body.TryGetProperty("deviceId", out var d) ? (d.GetString() ?? "").Trim() : "";
     var serial = body.TryGetProperty("serial", out var s) ? (s.GetString() ?? "").Trim() : "";
     if (string.IsNullOrWhiteSpace(deviceId)) return Results.BadRequest("DEVICE_REQUIRED");
     if (string.IsNullOrWhiteSpace(serial)) return Results.BadRequest("SERIAL_REQUIRED");

     await using var con = await OpenPg(cfg);

     int planDays=0, maxDevices=1; bool serialActive=false;
     await using (var scmd = new Npgsql.NpgsqlCommand(@"
         SELECT p.days, k.max_devices, k.is_active
         FROM lic_keys k
         JOIN lic_plans p ON p.id = k.plan_id
         WHERE k.serial=@s
         LIMIT 1;", con))
     {
         scmd.Parameters.AddWithValue("s", serial);
         await using var rd = await scmd.ExecuteReaderAsync();
         if (!await rd.ReadAsync()) return Results.BadRequest("SERIAL_NOT_FOUND");
         planDays = rd.GetInt32(0);
         maxDevices = rd.GetInt32(1);
         serialActive = rd.GetBoolean(2);
     }
     if (!serialActive) return Results.BadRequest("SERIAL_DISABLED");

     long deviceCount = 0;
     await using (var ccmd = new Npgsql.NpgsqlCommand("SELECT COUNT(*) FROM lic_devices WHERE serial=@s;", con))
     {
         ccmd.Parameters.AddWithValue("s", serial);
         deviceCount = (long)(await ccmd.ExecuteScalarAsync() ?? 0L);
     }

     long exists = 0;
     await using (var ecmd = new Npgsql.NpgsqlCommand("SELECT COUNT(*) FROM lic_devices WHERE serial=@s AND device_id=@d;", con))
     {
         ecmd.Parameters.AddWithValue("s", serial);
         ecmd.Parameters.AddWithValue("d", deviceId);
         exists = (long)(await ecmd.ExecuteScalarAsync() ?? 0L);
     }

     if (exists == 0 && deviceCount >= maxDevices) return Results.BadRequest("MAX_DEVICES_REACHED");

     if (exists == 0)
     {
         await using var icmd = new Npgsql.NpgsqlCommand("INSERT INTO lic_devices(serial, device_id) VALUES (@s,@d);", con);
         icmd.Parameters.AddWithValue("s", serial);
         icmd.Parameters.AddWithValue("d", deviceId);
         await icmd.ExecuteNonQueryAsync();
     }
     else
     {
         await using var ucmd = new Npgsql.NpgsqlCommand("UPDATE lic_devices SET last_seen_utc=NOW() WHERE serial=@s AND device_id=@d;", con);
         ucmd.Parameters.AddWithValue("s", serial);
         ucmd.Parameters.AddWithValue("d", deviceId);
         await ucmd.ExecuteNonQueryAsync();
     }

     var expires = DateTime.UtcNow.AddDays(Math.Max(1, planDays));
     await using (var up = new Npgsql.NpgsqlCommand(@"
        INSERT INTO lic_device_subs(device_id, mode, serial, expires_utc, last_check_utc, created_utc)
        VALUES (@d, 'SERIAL', @s, @exp, NOW(), NOW())
        ON CONFLICT (device_id) DO UPDATE SET
           mode='SERIAL', serial=EXCLUDED.serial, expires_utc=EXCLUDED.expires_utc, last_check_utc=NOW();", con))
     {
         up.Parameters.AddWithValue("d", deviceId);
         up.Parameters.AddWithValue("s", serial);
         up.Parameters.AddWithValue("exp", expires);
         await up.ExecuteNonQueryAsync();
     }

     return Results.Ok(new { ok=true, mode="SERIAL", expiresUtc=expires, planDays, maxDevices, offlineGraceDays=GetOfflineGraceDays(cfg) });
 });
 
