static string GenSerial()
{
    // NADER-XXXX-XXXX-XXXX
    string Part()
    {
        const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
        var bytes = System.Security.Cryptography.RandomNumberGenerator.GetBytes(4);
        var sb = new System.Text.StringBuilder(4);
        foreach (var b in bytes) sb.Append(chars[b % chars.Length]);
        return sb.ToString();
    }
    return $"NADER-{Part()}-{Part()}-{Part()}";
}

app.MapGet("/api/admin/licenses", async (HttpRequest req, IConfiguration cfg) =>
{
    if (!CheckAdmin(req, cfg, out var fail)) return fail!;
    int take = 200;
    if (int.TryParse(req.Query["take"], out var t)) take = Math.Clamp(t, 1, 2000);

    await using var con = await OpenPg(cfg);
    var sql = @"
SELECT k.id, k.serial, k.plan_id, p.name, p.days, p.price, k.is_active, k.max_devices, k.created_utc
FROM lic_keys k
JOIN lic_plans p ON p.id = k.plan_id
ORDER BY k.id DESC
LIMIT @take;";
    await using var cmd = new Npgsql.NpgsqlCommand(sql, con);
    cmd.Parameters.AddWithValue("take", take);
    await using var rd = await cmd.ExecuteReaderAsync();
    var list = new List<object>();
    while (await rd.ReadAsync())
    {
        list.Add(new {
            id = rd.GetInt64(0),
            serial = rd.GetString(1),
            planId = rd.GetInt64(2),
            planName = rd.GetString(3),
            planDays = rd.GetInt32(4),
            planPrice = rd.GetDecimal(5),
            isActive = rd.GetBoolean(6),
            maxDevices = rd.GetInt32(7),
            createdUtc = rd.GetDateTime(8)
        });
    }
    return Results.Ok(new { licenses = list });
});

app.MapPost("/api/admin/licenses/generate", async (HttpRequest req, IConfiguration cfg) =>
{
    if (!CheckAdmin(req, cfg, out var fail)) return fail!;
    var body = await req.ReadFromJsonAsync<JsonElement>();
    if (body.ValueKind != JsonValueKind.Object) return Results.BadRequest("INVALID_BODY");

    var planId = body.TryGetProperty("planId", out var pid) && pid.ValueKind == JsonValueKind.Number ? pid.GetInt64() : 0;
    var maxDevices = body.TryGetProperty("maxDevices", out var md) && md.ValueKind == JsonValueKind.Number ? md.GetInt32() : 1;
    var count = body.TryGetProperty("count", out var c) && c.ValueKind == JsonValueKind.Number ? c.GetInt32() : 1;

    if (planId <= 0) return Results.BadRequest("PLAN_REQUIRED");
    maxDevices = Math.Clamp(maxDevices, 1, 50);
    count = Math.Clamp(count, 1, 200);

    await using var con = await OpenPg(cfg);

    // ensure plan exists
    await using (var pcmd = new Npgsql.NpgsqlCommand("SELECT COUNT(*) FROM lic_plans WHERE id=@id;", con))
    {
        pcmd.Parameters.AddWithValue("id", planId);
        var exists = (long)(await pcmd.ExecuteScalarAsync() ?? 0L);
        if (exists == 0) return Results.BadRequest("PLAN_NOT_FOUND");
    }

    var created = new List<string>();
    for (int i = 0; i < count; i++)
    {
        // retry few times to avoid unique collision
        for (int tries = 0; tries < 5; tries++)
        {
            var serial = GenSerial();
            try
            {
                var sql = "INSERT INTO lic_keys(serial,plan_id,is_active,max_devices,created_utc) VALUES (@s,@pid,TRUE,@md,NOW());";
                await using var cmd = new Npgsql.NpgsqlCommand(sql, con);
                cmd.Parameters.AddWithValue("s", serial);
                cmd.Parameters.AddWithValue("pid", planId);
                cmd.Parameters.AddWithValue("md", maxDevices);
                await cmd.ExecuteNonQueryAsync();
                created.Add(serial);
                break;
            }
            catch (Npgsql.PostgresException ex) when (ex.SqlState == "23505")
            {
                // unique violation, try again
            }
        }
    }

    return Results.Ok(new { created });
});

