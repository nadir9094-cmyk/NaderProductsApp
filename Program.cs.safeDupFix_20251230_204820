 app.MapGet("/api/subscription/plans", async (IConfiguration cfg) =>
{
    await using var con = await OpenPg(cfg);

    // عرض باقات العملاء (تشمل العروض إن وجدت)
    await using var cmd = new Npgsql.NpgsqlCommand(@"
      SELECT id, name, days, price, is_active,
             COALESCE(offer_type,''), COALESCE(offer_value,0),
             offer_start, offer_end
      FROM lic_plans
      ORDER BY id ASC;", con);

    var now = DateTime.UtcNow;
    var list = new List<object>();
    await using var rd = await cmd.ExecuteReaderAsync();
    while (await rd.ReadAsync())
    {
        var id = rd.GetInt64(0);
        var name = rd.GetString(1);
        var days = rd.GetInt32(2);
        var price = rd.GetDecimal(3);
        var isActive = rd.GetBoolean(4);

        var offerType = rd.GetString(5);
        var offerValue = rd.GetDecimal(6);
        DateTime? offerStart = rd.IsDBNull(7) ? (DateTime?)null : rd.GetDateTime(7);
        DateTime? offerEnd   = rd.IsDBNull(8) ? (DateTime?)null : rd.GetDateTime(8);

        bool inWindow = true;
        if (offerStart.HasValue && now < offerStart.Value) inWindow = false;
        if (offerEnd.HasValue && now > offerEnd.Value) inWindow = false;

        bool hasOffer = isActive && inWindow && offerValue > 0m &&
                        (offerType == "PERCENT" || offerType == "AMOUNT");

        decimal finalPrice = price;
        if (hasOffer)
        {
            if (offerType == "PERCENT")
                finalPrice = price - (price * offerValue / 100m);
            else if (offerType == "AMOUNT")
                finalPrice = price - offerValue;

            if (finalPrice < 0m) finalPrice = 0m;
            finalPrice = Math.Round(finalPrice, 2, MidpointRounding.AwayFromZero);
        }

        list.Add(new
        {
            id,
            name,
            days,
            isActive,
            price = Math.Round(price, 2, MidpointRounding.AwayFromZero),
            hasOffer,
            offerType = hasOffer ? offerType : null,
            offerValue = hasOffer ? offerValue : (decimal?)null,
            offerStart,
            offerEnd,
            finalPrice,
            badgeText = hasOffer ? "عرض حصري" : null
