    string fromDate = (req.Query["fromDate"].ToString() ?? "").Trim();
    string toDate   = (req.Query["toDate"].ToString() ?? "").Trim();
    string minAmountStr = (req.Query["minAmount"].ToString() ?? "").Trim();
    string maxAmountStr = (req.Query["maxAmount"].ToString() ?? "").Trim();

    DateTime? fd = null; DateTime? td = null;
    if (!string.IsNullOrWhiteSpace(fromDate) && DateTime.TryParse(fromDate, out var _fd)) fd = _fd.Date;
    if (!string.IsNullOrWhiteSpace(toDate)   && DateTime.TryParse(toDate, out var _td)) td = _td.Date.AddDays(1).AddTicks(-1);

    decimal? minAmount = null; decimal? maxAmount = null;
    if (!string.IsNullOrWhiteSpace(minAmountStr) && decimal.TryParse(minAmountStr, out var _min)) minAmount = _min;
    if (!string.IsNullOrWhiteSpace(maxAmountStr) && decimal.TryParse(maxAmountStr, out var _max)) maxAmount = _max;

    var query = db.Expenses.AsNoTracking().AsQueryable();

    if (fd.HasValue) query = query.Where(x => x.Date >= fd.Value);
    if (td.HasValue) query = query.Where(x => x.Date <= td.Value);
    if (minAmount.HasValue) query = query.Where(x => x.Amount >= minAmount.Value);
    if (maxAmount.HasValue) query = query.Where(x => x.Amount <= maxAmount.Value);

    if (!string.IsNullOrWhiteSpace(q))
    {
        var qq = q.ToLower();
        query = query.Where(x => (x.Statement ?? "").ToLower().Contains(qq));
    }

    var rows = await query
        .OrderByDescending(x => x.Date)
        .ThenByDescending(x => x.Id)
        .Select(x => new {
            id = x.Id,
            date = KsaTime.ToKsaIso(x.Date),
            statement = x.Statement ?? "",
            amount = x.Amount
        })
        .ToListAsync();

    return Results.Ok(rows);
});

