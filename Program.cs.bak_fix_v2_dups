// حفظ الإعدادات فعلياً داخل نفس قاعدة SQLite (naderpos.db) بدون تعديل AppDbContext
// جدول AppSettings (صف واحد فقط Id=1)

static string SettingsConnString() => "Data Source=naderpos.db";

static void EnsureSettingsTable()
{
    using var con = new SqliteConnection(SettingsConnString());
    con.Open();
    using var cmd = con.CreateCommand();
    cmd.CommandText = @"
CREATE TABLE IF NOT EXISTS AppSettings (
    Id INTEGER PRIMARY KEY CHECK (Id = 1),

    StoreName TEXT NULL,
    CommercialRegister TEXT NULL,
    VatNumber TEXT NULL,
    StoreAddress TEXT NULL,
    StorePhone TEXT NULL,

    InvoicePaper TEXT NULL,            -- A4 | Cashier
    CashierPaperWidthMm INTEGER NULL,  -- default 80
    StoreLogoBase64 TEXT NULL,         -- data:image/...;base64,....
    InvoiceFooterNotes TEXT NULL,

    BarcodeType TEXT NULL,             -- QR
    ZatcaPhase INTEGER NULL,           -- 1 | 2

    Phase2InvoiceHash TEXT NULL,
    Phase2Signature TEXT NULL,
    Phase2PublicKey TEXT NULL,
    Phase2CertificateSignature TEXT NULL
);

INSERT INTO AppSettings (Id, InvoicePaper, CashierPaperWidthMm, BarcodeType, ZatcaPhase)
SELECT 1, 'Cashier', 80, 'QR', 1
WHERE NOT EXISTS (SELECT 1 FROM AppSettings WHERE Id = 1);
";
    cmd.ExecuteNonQuery();
}

static object ReadSettings()
{
    EnsureSettingsTable();
    using var con = new SqliteConnection(SettingsConnString());
    con.Open();
    using var cmd = con.CreateCommand();
    cmd.CommandText = "SELECT * FROM AppSettings WHERE Id=1 LIMIT 1;";
    using var r = cmd.ExecuteReader();
    if (!r.Read())
    {
        return new {
            storeName = "",
            commercialRegister = "",
            vatNumber = "",
            storeAddress = "",
            storePhone = "",
            invoicePaper = "Cashier",
            cashierPaperWidthMm = 80,
            storeLogoBase64 = "",
            invoiceFooterNotes = "",
            barcodeType = "QR",
            zatcaPhase = 1,
            phase2InvoiceHash = "",
            phase2Signature = "",
            phase2PublicKey = "",
            phase2CertificateSignature = ""
        };
    }

    string GetS(string col) => r[col] is DBNull ? "" : Convert.ToString(r[col]) ?? "";
    int GetI(string col, int defv)
    {
        if (r[col] is DBNull) return defv;
        if (int.TryParse(Convert.ToString(r[col]), out var v)) return v;
        return defv;
    }

    return new {
        storeName = GetS("StoreName"),
        commercialRegister = GetS("CommercialRegister"),
        vatNumber = GetS("VatNumber"),
        storeAddress = GetS("StoreAddress"),
        storePhone = GetS("StorePhone"),
        invoicePaper = string.IsNullOrWhiteSpace(GetS("InvoicePaper")) ? "Cashier" : GetS("InvoicePaper"),
        cashierPaperWidthMm = GetI("CashierPaperWidthMm", 80),
        storeLogoBase64 = GetS("StoreLogoBase64"),
        invoiceFooterNotes = GetS("InvoiceFooterNotes"),
        barcodeType = string.IsNullOrWhiteSpace(GetS("BarcodeType")) ? "QR" : GetS("BarcodeType"),
        zatcaPhase = GetI("ZatcaPhase", 1),
        phase2InvoiceHash = GetS("Phase2InvoiceHash"),
        phase2Signature = GetS("Phase2Signature"),
        phase2PublicKey = GetS("Phase2PublicKey"),
        phase2CertificateSignature = GetS("Phase2CertificateSignature")
    };
}



static IResult SaveSettings(SettingsDto input)
{
    EnsureSettingsTable();

    var invoicePaper = (input.InvoicePaper ?? "Cashier").Trim();
    if (invoicePaper != "A4" && invoicePaper != "Cashier") invoicePaper = "Cashier";

    var barcodeType = (input.BarcodeType ?? "QR").Trim().ToUpperInvariant();
    if (barcodeType != "QR") barcodeType = "QR";

    var phase = input.ZatcaPhase == 2 ? 2 : 1;

    var width = input.CashierPaperWidthMm <= 0 ? 80 : input.CashierPaperWidthMm;
    if (width < 58) width = 58;
    if (width > 120) width = 120;

    var logo = (input.StoreLogoBase64 ?? "").Trim();
    if (logo.Length > 2_000_000) return Results.BadRequest("LOGO_TOO_LARGE");

    using var con = new SqliteConnection(SettingsConnString());
    con.Open();
    using var cmd = con.CreateCommand();
    cmd.CommandText = @"
UPDATE AppSettings SET
    StoreName=@StoreName,
    CommercialRegister=@CommercialRegister,
    VatNumber=@VatNumber,
    StoreAddress=@StoreAddress,
    StorePhone=@StorePhone,

    InvoicePaper=@InvoicePaper,
    CashierPaperWidthMm=@CashierPaperWidthMm,
    StoreLogoBase64=@StoreLogoBase64,
    InvoiceFooterNotes=@InvoiceFooterNotes,

    BarcodeType=@BarcodeType,
    ZatcaPhase=@ZatcaPhase,

    Phase2InvoiceHash=@Phase2InvoiceHash,
    Phase2Signature=@Phase2Signature,
    Phase2PublicKey=@Phase2PublicKey,
    Phase2CertificateSignature=@Phase2CertificateSignature
WHERE Id=1;
";
    cmd.Parameters.AddWithValue("@StoreName", (input.StoreName ?? "").Trim());
    cmd.Parameters.AddWithValue("@CommercialRegister", (input.CommercialRegister ?? "").Trim());
    cmd.Parameters.AddWithValue("@VatNumber", (input.VatNumber ?? "").Trim());
    cmd.Parameters.AddWithValue("@StoreAddress", (input.StoreAddress ?? "").Trim());
    cmd.Parameters.AddWithValue("@StorePhone", (input.StorePhone ?? "").Trim());

    cmd.Parameters.AddWithValue("@InvoicePaper", invoicePaper);
    cmd.Parameters.AddWithValue("@CashierPaperWidthMm", width);
    cmd.Parameters.AddWithValue("@StoreLogoBase64", logo);
    cmd.Parameters.AddWithValue("@InvoiceFooterNotes", (input.InvoiceFooterNotes ?? "").Trim());

    cmd.Parameters.AddWithValue("@BarcodeType", barcodeType);
    cmd.Parameters.AddWithValue("@ZatcaPhase", phase);

    cmd.Parameters.AddWithValue("@Phase2InvoiceHash", phase == 2 ? (input.Phase2InvoiceHash ?? "").Trim() : "");
    cmd.Parameters.AddWithValue("@Phase2Signature", phase == 2 ? (input.Phase2Signature ?? "").Trim() : "");
    cmd.Parameters.AddWithValue("@Phase2PublicKey", phase == 2 ? (input.Phase2PublicKey ?? "").Trim() : "");
    cmd.Parameters.AddWithValue("@Phase2CertificateSignature", phase == 2 ? (input.Phase2CertificateSignature ?? "").Trim() : "");

    cmd.ExecuteNonQuery();
    return Results.Ok(new { ok = true });
}

