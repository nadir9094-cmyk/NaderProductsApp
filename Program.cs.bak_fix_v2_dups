// ======================= SUPPLIERS STORE (PERSISTED) =======================
// تخزين شاشة الموردين (Suppliers/Invoicing/Payments) كـ JSON داخل نفس naderpos.db بدون تعديل AppDbContext
static void EnsureSuppliersStoreTable()
{
    using var con = new SqliteConnection("Data Source=naderpos.db");
    con.Open();
    using var cmd = con.CreateCommand();
    cmd.CommandText = @"
CREATE TABLE IF NOT EXISTS SuppliersStore(
    Id INTEGER PRIMARY KEY CHECK (Id=1),
    Json TEXT NOT NULL
);
INSERT INTO SuppliersStore (Id, Json)
SELECT 1, '{""suppliers"":[], ""invoices"":[], ""payments"":[]}'
WHERE NOT EXISTS (SELECT 1 FROM SuppliersStore WHERE Id=1);
";
    cmd.ExecuteNonQuery();
}

static string ReadSuppliersStoreJson()
{
    EnsureSuppliersStoreTable();
    using var con = new SqliteConnection("Data Source=naderpos.db");
    con.Open();
    using var cmd = con.CreateCommand();
    cmd.CommandText = "SELECT Json FROM SuppliersStore WHERE Id=1 LIMIT 1;";
    var v = cmd.ExecuteScalar();
    return v is null || v is DBNull ? @"{""suppliers"":[], ""invoices"":[], ""payments"":[]}" : Convert.ToString(v) ?? @"{""suppliers"":[], ""invoices"":[], ""payments"":[]}";
}

static IResult SaveSuppliersStoreJson(string json)
{
    EnsureSuppliersStoreTable();
    using var con = new SqliteConnection("Data Source=naderpos.db");
    con.Open();
    using var cmd = con.CreateCommand();
    cmd.CommandText = "UPDATE SuppliersStore SET Json=@j WHERE Id=1;";
    cmd.Parameters.AddWithValue("@j", json ?? @"{""suppliers"":[], ""invoices"":[], ""payments"":[]}");
    cmd.ExecuteNonQuery();
    return Results.Ok(new { ok = true });
}

// API: GET/PUT suppliers-store
app.MapGet("/api/suppliers-store", () =>
{
    var json = ReadSuppliersStoreJson();
    return Results.Text(json, "application/json; charset=utf-8");
});

app.MapPut("/api/suppliers-store", async (HttpRequest request) =>
{
    using var sr = new StreamReader(request.Body);
    var raw = await sr.ReadToEndAsync();
    if (string.IsNullOrWhiteSpace(raw)) return Results.BadRequest("EMPTY_BODY");
    return SaveSuppliersStoreJson(raw);
});

